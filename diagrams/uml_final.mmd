classDiagram
    class Task {
        +str description
        +str time
        +str frequency
        +date due_date
        +bool completed
        +str pet_name
        +str priority
        +int duration_minutes
        +__post_init__()
        +mark_complete()
    }
    class Pet {
        +str name
        +str species
        +List~Task~ tasks
        +add_task(task)
        +remove_task(task)
    }
    class Owner {
        +str name
        +List~Pet~ pets
        +add_pet(pet)
        +get_all_tasks() List~Task~
    }
    class Scheduler {
        +Owner owner
        +get_todays_schedule(today) List~Task~
        +sort_by_time(tasks) List~Task~
        +filter_tasks(pet_name, completed, tasks) List~Task~
        +detect_conflicts(tasks) List~str~
        +mark_task_complete(task) Task
    }
    Owner "1" --> "*" Pet : has
    Pet "1" --> "*" Task : has
    Scheduler --> Owner : reads from
    Scheduler ..> Task : creates next occurrence